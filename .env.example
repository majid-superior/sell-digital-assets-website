# =============================================================================
# AssetDrop Marketplace - Environment Configuration Template (.env.example)
# Reference: Based on local .env configuration
# Copy this file to .env for local development:
#   cp .env.example .env
#
# SECURITY NOTICE:
# Never store private secrets, database credentials, or private API keys here.
# All VITE_* variables are exposed to the public client-side browser bundle.
# =============================================================================

# Backend API Server URL (Reference: .env -> VITE_API_URL)
# In local development: http://localhost:5000
VITE_API_URL=http://localhost:5000

# Backend API Base URL / Endpoint Prefix (Reference: .env -> VITE_API_BASE_URL)
# In local development: /api/v1 (proxied by Vite to VITE_API_URL)
# In production:        https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=/api/v1

# Optional: Local Dev Proxy Target (Defaults to http://localhost:5000 if omitted)
# VITE_BACKEND_ORIGIN=http://localhost:5000

# Optional: Application Brand / Organization Title (Defaults to AssetDrop)
# VITE_APP_ORGANIZATION_TITLE=AssetDrop
