# =============================================================================
# AssetDrop Marketplace - Production Environment Template (.env.production)
# Reference: Based on .env schema for production hosting platforms
# (Vercel, Netlify, Render, Railway, AWS Amplify, Docker)
#
# SECURITY NOTICE:
# Never store private secrets, database credentials, or signing keys here.
# All VITE_* variables are embedded directly into public client JavaScript.
# No sensitive credentials or secrets should ever be committed to source control.
# =============================================================================

# Production Backend API Server URL (Reference: .env -> VITE_API_URL)
# Set this to your live production API domain in your hosting platform dashboard:
VITE_API_URL=https://api.yourdomain.com

# Production Backend API Base URL (Reference: .env -> VITE_API_BASE_URL)
# Set to your live backend API v1 endpoint in your hosting platform dashboard:
# Example (subdomain): https://api.yourdomain.com/api/v1
# Example (same domain / reverse proxy): /api/v1
VITE_API_BASE_URL=https://api.yourdomain.com/api/v1

# Optional: Production Application Brand / Organization Title
VITE_APP_ORGANIZATION_TITLE=AssetDrop

# Optional Legacy Fallback:
# API_BASE_URL=https://api.yourdomain.com/api/v1
